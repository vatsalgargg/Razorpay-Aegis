# Razorpay Aegis — Environment Variables Template
# Copy this file to .env and insert your API keys:

# Groq Cloud API Key (Recommended: Free 14,400 requests/day from console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (Alternative / Fallback from aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Gateway Settings
LLM_TIMEOUT_SECONDS=8
FORCE_LLM_TIMEOUT=false
DB_PATH=razorpay_risk.db
WINDOW_MINUTES=5
MAX_BUFFER_TXN=2000
API_URL=http://localhost:8000
